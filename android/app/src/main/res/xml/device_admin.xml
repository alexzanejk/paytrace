<?xml version="1.0" encoding="utf-8"?>
<!-- What this admin is allowed to do. DELIBERATELY EMPTY.

     This file exists only so that `adb shell dpm set-device-owner` has a receiver to point at: we are finding out
     whether this phone's brand lets a device owner be set at all. No policy is listed, so even once PayTrace IS the
     device owner it enforces nothing, changes nothing and takes nothing away. Powers get added here one at a time,
     and only after the owner has agreed to each one. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies />
</device-admin>
