/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://mkjcqwkfbamnuibmurcd.supabase.co wss://mkjcqwkfbamnuibmurcd.supabase.co https://api.github.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

# The installable-app files must never be kept stale: a new service worker or manifest is picked up on the next open.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# The customer pay page may be shown inside a website's iframe (so the customer stays on the website's own address).
# Only this page: the admin dashboard and everything else above keeps DENY / frame-ancestors 'none'.
/pay
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://mkjcqwkfbamnuibmurcd.supabase.co; frame-ancestors https:; base-uri 'none'; form-action 'self'
/pay/*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://mkjcqwkfbamnuibmurcd.supabase.co; frame-ancestors https:; base-uri 'none'; form-action 'self'

# The one-file copy of the pay page that websites download (Websites -> Pay page code). Its script, styles, fonts and pictures
# are inside the file, so inline script and data: fonts must be allowed; only the dashboard itself may show it in a frame
# (its preview). It talks to no server from our address (in preview mode it talks to none at all).
/selfpay/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'
